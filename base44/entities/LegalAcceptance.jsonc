{
  "name": "LegalAcceptance",
  "type": "object",
  "properties": {
    "condominium_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "terms_sha256": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected"
      ]
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "decided_by_user_id": {
      "type": "string"
    },
    "decided_by_name": {
      "type": "string"
    },
    "decided_by_email": {
      "type": "string"
    }
  },
  "required": [
    "condominium_id",
    "version",
    "decision"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}