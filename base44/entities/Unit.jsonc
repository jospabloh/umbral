{
  "name": "Unit",
  "type": "object",
  "properties": {
    "condominium_id": {
      "type": "string"
    },
    "internal_id": {
      "type": "string",
      "description": "Identificador interno, ej. Casa 12, A-101"
    },
    "label": {
      "type": "string",
      "description": "Nombre legible de la unidad"
    },
    "resident_user_id": {
      "type": "string",
      "description": "Residente asignado"
    },
    "resident_name": {
      "type": "string",
      "description": "Nombre del residente (denormalizado)"
    },
    "type": {
      "type": "string",
      "enum": [
        "casa",
        "departamento",
        "local",
        "estacionamiento"
      ],
      "default": "casa"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "vacant"
      ],
      "default": "vacant"
    }
  },
  "required": [
    "condominium_id",
    "internal_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.condominium_id": "{{user.data.condominium_id}}"
            },
            {
              "user_condition": {
                "role": "condo_admin"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.condominium_id": "{{user.data.condominium_id}}"
            },
            {
              "user_condition": {
                "role": "committee"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.condominium_id": "{{user.data.condominium_id}}"
            },
            {
              "user_condition": {
                "role": "guard"
              }
            }
          ]
        },
        {
          "data.resident_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}