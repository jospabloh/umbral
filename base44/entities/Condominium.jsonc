{
  "name": "Condominium",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre comercial del condominio o fraccionamiento."
    },
    "legal_name": {
      "type": "string",
      "description": "Raz\u00f3n social. Necesaria para publicar la p\u00e1gina p\u00fablica del pase."
    },
    "address": {
      "type": "string",
      "description": "Domicilio completo. Necesario para publicar la p\u00e1gina p\u00fablica del pase."
    },
    "privacy_contact_email": {
      "type": "string",
      "description": "Correo de contacto de privacidad. Necesario para publicar la p\u00e1gina p\u00fablica del pase."
    },
    "join_code": {
      "type": "string",
      "description": "C\u00f3digo de invitaci\u00f3n generado por el servidor."
    },
    "billing_status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "view_only",
        "suspended"
      ],
      "default": "trial",
      "description": "Lo escribe \u00fanicamente Mission Control. La app lo lee para degradar la interfaz. Esta regla gobierna la escritura, no la lectura."
    },
    "trial_end_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fin de la prueba. Solo escritura de plataforma: la fija onboarding al crear (service role) y Mission Control v\u00eda acaciaControl. Esta regla gobierna la ESCRITURA, no la lectura: la app la lee para mostrar los d\u00edas restantes; un inquilino no debe poder alargar su propia prueba."
    },
    "license_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Vencimiento de la licencia pagada. Solo escritura de plataforma (rls.write = admin): la escribe \u00fanicamente Mission Control v\u00eda acaciaControl (service role). Este candado gobierna la ESCRITURA, no la lectura: la app puede leerla para avisar del vencimiento. Un inquilino no debe poder extender su propia licencia.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "license_plan": {
      "type": "string",
      "description": "Plan de la licencia. Solo escritura de plataforma (rls.write = admin): la escribe \u00fanicamente Mission Control v\u00eda acaciaControl (service role). Este candado gobierna la ESCRITURA, no la lectura. Un inquilino no debe poder cambiarse de plan por su cuenta.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "legal_version": {
      "type": "string",
      "description": "Versi\u00f3n de t\u00e9rminos sobre la que el condominio ha decidido."
    },
    "legal_decision": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected"
      ],
      "default": "pending"
    },
    "legal_decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "legal_first_asked_at": {
      "type": "string",
      "format": "date-time"
    },
    "access_log_retention_days": {
      "type": "number",
      "default": 180
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "id": "{{user.data.condominium_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
