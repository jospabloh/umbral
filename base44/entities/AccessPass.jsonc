{
  "name": "AccessPass",
  "type": "object",
  "properties": {
    "condominium_id": {
      "type": "string"
    },
    "unit_id": {
      "type": "string"
    },
    "unit_label": {
      "type": "string"
    },
    "created_by_user_id": {
      "type": "string"
    },
    "visitor_name": {
      "type": "string"
    },
    "visitor_phone": {
      "type": "string"
    },
    "pass_type": {
      "type": "string",
      "enum": [
        "single",
        "recurring",
        "resident"
      ],
      "default": "single"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "used",
        "expired",
        "revoked"
      ],
      "default": "active"
    },
    "qr_token": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "condominium_id",
    "visitor_name",
    "qr_token"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.condominium_id": "{{user.data.condominium_id}}"
            },
            {
              "user_condition": {
                "role": "condo_admin"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.condominium_id": "{{user.data.condominium_id}}"
            },
            {
              "user_condition": {
                "role": "committee"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.condominium_id": "{{user.data.condominium_id}}"
            },
            {
              "user_condition": {
                "role": "guard"
              }
            }
          ]
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}