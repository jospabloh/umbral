{
  "name": "Supplier",
  "type": "object",
  "properties": {
    "condominium_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Nombre o raz\u00f3n social del proveedor."
    },
    "category": {
      "type": "string",
      "enum": [
        "mantenimiento",
        "seguridad",
        "limpieza",
        "jardineria",
        "servicios",
        "suministros",
        "otro"
      ],
      "default": "otro"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "rfc": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "condominium_id",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.condominium_id": "{{user.data.condominium_id}}"
            },
            {
              "user_condition": {
                "role": "condo_admin"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.condominium_id": "{{user.data.condominium_id}}"
            },
            {
              "user_condition": {
                "role": "committee"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}