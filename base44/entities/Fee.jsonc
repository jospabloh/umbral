{
  "name": "Fee",
  "type": "object",
  "properties": {
    "condominium_id": {
      "type": "string"
    },
    "unit_id": {
      "type": "string",
      "description": "Null = aplica a todas las unidades"
    },
    "unit_label": {
      "type": "string"
    },
    "concept": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "one_time",
        "monthly",
        "quarterly",
        "annual"
      ],
      "default": "one_time"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "cancelled"
      ],
      "default": "active"
    },
    "created_by_user_id": {
      "type": "string"
    }
  },
  "required": [
    "condominium_id",
    "concept",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.condominium_id": "{{user.data.condominium_id}}"
            },
            {
              "user_condition": {
                "role": "condo_admin"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.condominium_id": "{{user.data.condominium_id}}"
            },
            {
              "user_condition": {
                "role": "committee"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}