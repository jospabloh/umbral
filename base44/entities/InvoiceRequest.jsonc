{
  "name": "InvoiceRequest",
  "type": "object",
  "properties": {
    "condominium_id": {
      "type": "string"
    },
    "payment_id": {
      "type": "string"
    },
    "unit_id": {
      "type": "string"
    },
    "unit_label": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "concept": {
      "type": "string"
    },
    "fiscal_rfc": {
      "type": "string"
    },
    "fiscal_name": {
      "type": "string"
    },
    "fiscal_regime": {
      "type": "string"
    },
    "fiscal_use": {
      "type": "string"
    },
    "fiscal_email": {
      "type": "string",
      "description": "Correo al que se env\u00eda el CFDI."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "issued",
        "rejected"
      ],
      "default": "pending"
    },
    "requested_by_user_id": {
      "type": "string"
    },
    "requested_by_name": {
      "type": "string"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "invoice_number": {
      "type": "string"
    },
    "invoice_file_uri": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "issued_by_user_id": {
      "type": "string"
    },
    "issued_by_name": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "condominium_id",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.requested_by_user_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.condominium_id": "{{user.data.condominium_id}}"
            },
            {
              "user_condition": {
                "role": "condo_admin"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.condominium_id": "{{user.data.condominium_id}}"
            },
            {
              "user_condition": {
                "role": "committee"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}