{
  "name": "LegalVersionCache",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "published": {
      "type": "string",
      "format": "date-time"
    },
    "grace_days": {
      "type": "number",
      "default": 15
    },
    "terms_sha256": {
      "type": "string"
    },
    "terms_url": {
      "type": "string"
    },
    "privacy_url": {
      "type": "string"
    },
    "changes_es": {
      "type": "string"
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "version"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}